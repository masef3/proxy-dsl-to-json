suite {
    port = 8080
    rules {
        case "/login" {
            split  "http://localhost:3000" = 80,
                   "http://localhost:3001" = 20

        }

        case "/home" {
            target "http://localhost:3002"
        }

        case "/api" {
            block "http://localhost:3003" : ( "Private url" )
                  "http://localhost:3004" : ( "Private url 2" )
        }
    }

}




